# Copy to .env and replace every "change-me" value (`make env` does this with random secrets).
# Nothing here is a real credential; .env is git-ignored.

POSTGRES_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
LAKEHOUSE_DB_PASSWORD=change-me
LAKEHOUSE_READER_PASSWORD=change-me

MINIO_ROOT_USER=lakehouse-admin
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

# Airflow: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_UID=50000

GRAFANA_ADMIN_PASSWORD=change-me

# Host ports (bound to 127.0.0.1 only). Defaults avoid the usual 5432/8080/9000.
POSTGRES_PORT=15432
MINIO_API_PORT=19010
MINIO_CONSOLE_PORT=19011
AIRFLOW_PORT=18088
API_PORT=18000
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

SPARK_DRIVER_MEMORY=2g
