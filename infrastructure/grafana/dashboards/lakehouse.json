{
  "uid": "lakehouse-ops",
  "title": "Lakehouse — Operations",
  "tags": ["lakehouse"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Last run failed (per pipeline)",
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "lakehouse-prometheus"},
      "targets": [{"expr": "lakehouse_last_run_failed", "legendFormat": "{{pipeline}}", "refId": "A"}],
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {
        "mappings": [{"type": "value", "options": {"0": {"text": "OK"}, "1": {"text": "FAILED"}}}],
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Gold publication age",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "lakehouse-prometheus"},
      "targets": [{"expr": "lakehouse_gold_publication_age_seconds", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s",
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 86400}]}}}
    },
    {
      "id": 3, "type": "stat", "title": "Quarantined files",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "lakehouse-prometheus"},
      "targets": [{"expr": "sum(lakehouse_files{status=\"QUARANTINED\"}) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}}
    },
    {
      "id": 4, "type": "bargauge", "title": "Last run duration (s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "lakehouse-prometheus"},
      "targets": [{"expr": "lakehouse_last_run_duration_seconds", "legendFormat": "{{pipeline}}", "refId": "A"}],
      "options": {"orientation": "horizontal", "displayMode": "basic"},
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 5, "type": "bargauge", "title": "Throughput of last run (records/s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "lakehouse-prometheus"},
      "targets": [{"expr": "lakehouse_last_run_records_per_second", "legendFormat": "{{pipeline}}", "refId": "A"}],
      "options": {"orientation": "horizontal", "displayMode": "basic"},
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 6, "type": "bargauge", "title": "Silver: rejected records by entity",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "lakehouse-prometheus"},
      "targets": [{"expr": "lakehouse_layer_records_total{layer=\"silver\",kind=\"rejected\"}", "legendFormat": "{{entity}}", "refId": "A"}],
      "options": {"orientation": "horizontal", "displayMode": "basic"}
    },
    {
      "id": 7, "type": "timeseries", "title": "Records read per layer",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "lakehouse-prometheus"},
      "targets": [{"expr": "sum by (layer) (lakehouse_layer_records_total{kind=\"read\"})", "legendFormat": "{{layer}}", "refId": "A"}]
    },
    {
      "id": 8, "type": "table", "title": "Quality rules not passing (1 warned, 2 failed, 3 error)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "lakehouse-prometheus"},
      "targets": [
        {"expr": "lakehouse_quality_rule_status > 0", "format": "table", "instant": true, "refId": "A"},
        {"expr": "lakehouse_quality_rule_violations and on(rule_id) (lakehouse_quality_rule_status > 0)", "format": "table", "instant": true, "refId": "B"}
      ],
      "transformations": [
        {"id": "merge"},
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
          "renameByName": {"Value #A": "status", "Value #B": "violations"}}}
      ]
    }
  ]
}
